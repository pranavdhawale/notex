# Backend Configuration
PORT=8080
GIN_MODE=release
MONGO_URI=mongodb://<username>:<password>@mongodb:27017/?authSource=admin
REDIS_ADDR=redis:6379
CLIENT_ORIGIN=https://notex.domain.com

# Session Configuration (REQUIRED)
# Generate a secure random string of at least 32 characters
SESSION_SECRET=your-32-character-secret-key-change-this-in-production

# CORS & WebSocket Origins (comma-separated)
ALLOWED_ORIGINS=https://notex.domain.com,https://www.notex.domain.com

# Frontend Configuration
VITE_API_URL=https://notex.domain.com
